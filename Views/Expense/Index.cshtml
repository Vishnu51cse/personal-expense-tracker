@{
    ViewData["Title"] = "Expense Dashboard";
}

<!-- Dashboard Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-wallet2 text-primary me-2"></i>My Expense Dashboard
        </h2>
        <p class="text-muted small mb-0">Overview of your spending habits and transaction history</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#quickAddExpenseModal">
            <i class="bi bi-plus-lg me-1"></i> Quick Add
        </button>
        <a href="/Expense/Create" class="btn btn-outline-primary">
            <i class="bi bi-plus-circle me-1"></i> Full Form
        </a>
    </div>
</div>

<!-- Metric Stat Cards -->
<div class="row g-3 mb-4">
    <!-- Card 1: Total Lifetime Expenses -->
    <div class="col-md-4">
        <div class="card stat-card p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-primary-subtle text-primary me-3">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Total Expenses</span>
                    <h3 class="fw-bold mb-0 text-dark" id="summaryTotalAmount">₹0.00</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: This Month's Expenses -->
    <div class="col-md-4">
        <div class="card stat-card p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-success-subtle text-success me-3">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">This Month</span>
                    <h3 class="fw-bold mb-0 text-dark" id="summaryThisMonthAmount">₹0.00</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Total Recorded Entries -->
    <div class="col-md-4">
        <div class="card stat-card p-3 h-100">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-info-subtle text-info me-3">
                    <i class="bi bi-receipt"></i>
                </div>
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Total Records</span>
                    <h3 class="fw-bold mb-0 text-dark" id="summaryTotalCount">0</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content Row -->
<div class="row g-4">
    <!-- Left Column: Expense History & Filter -->
    <div class="col-lg-8">
        <div class="card bg-white shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clock-history me-1 text-primary"></i> Transaction History
                </h5>
                <!-- Category Filter -->
                <div class="d-flex align-items-center gap-2">
                    <label for="categoryFilterSelect" class="small text-muted fw-semibold mb-0">Filter:</label>
                    <select id="categoryFilterSelect" class="form-select form-select-sm" style="min-width: 170px;">
                        <option value="All">All Categories</option>
                    </select>
                </div>
            </div>

            <div class="card-body p-0">
                <!-- Loading State -->
                <div id="expensesLoadingState" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted small mt-2">Loading transactions...</p>
                </div>

                <!-- Empty State -->
                <div id="expensesEmptyState" class="text-center py-5 d-none">
                    <div class="text-muted mb-3" style="font-size: 3rem;">
                        <i class="bi bi-inbox"></i>
                    </div>
                    <h6 class="fw-bold text-dark">No expenses found</h6>
                    <p class="text-muted small mb-3">You haven't recorded any expenses in this category yet.</p>
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#quickAddExpenseModal">
                        <i class="bi bi-plus-lg me-1"></i> Add First Expense
                    </button>
                </div>

                <!-- Table Wrapper -->
                <div id="expensesTableWrapper" class="table-responsive d-none">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th style="width: 15%;">Date</th>
                                <th style="width: 35%;">Title / Description</th>
                                <th style="width: 20%;">Category</th>
                                <th style="width: 15%;" class="text-end">Amount</th>
                                <th style="width: 15%;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="expensesTableBody">
                            <!-- Populated dynamically via expense.js -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Category Breakdown -->
    <div class="col-lg-4">
        <div class="card bg-white shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-pie-chart-fill me-1 text-primary"></i> Category Breakdown
                </h5>
            </div>
            <div class="card-body" id="categoryBreakdownContainer">
                <div class="text-center py-4">
                    <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                </div>
            </div>
        </div>

        <!-- Security / JWT Info Box for Learning -->
        <div class="card bg-light border-0 mt-3 p-3 text-secondary small">
            <div class="d-flex align-items-center mb-2 text-dark fw-bold">
                <i class="bi bi-shield-check text-success me-2 fs-5"></i>
                <span>JWT Authentication Active</span>
            </div>
            <p class="mb-2">
                Your session is protected by a cryptographically signed JSON Web Token (JWT). Every query and mutation transmits the Bearer token in the <code>Authorization</code> request header.
            </p>
            <span class="text-muted" style="font-size: 0.75rem;">Multi-tenant isolation ensures only your records are accessible.</span>
        </div>
    </div>
</div>

<!-- Quick Add Expense Modal -->
<div class="modal fade" id="quickAddExpenseModal" tabindex="-1" aria-labelledby="quickAddExpenseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="quickAddExpenseModalLabel">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Add New Expense
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="quickAddExpenseForm" onsubmit="handleQuickAddExpense(event)">
                <div class="modal-body">
                    <div id="modalAddError" class="alert alert-danger d-none" role="alert"></div>

                    <div class="mb-3">
                        <label for="modalExpenseTitle" class="form-label fw-semibold">Expense Title</label>
                        <input type="text" class="form-control" id="modalExpenseTitle" placeholder="e.g. Grocery Shopping" required maxlength="100" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label for="modalExpenseAmount" class="form-label fw-semibold">Amount (₹)</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input type="number" step="0.01" min="0.01" max="10000000" class="form-control" id="modalExpenseAmount" placeholder="0.00" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="modalExpenseCategory" class="form-label fw-semibold">Category</label>
                            <select id="modalExpenseCategory" class="form-select" required>
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="modalExpenseDate" class="form-label fw-semibold">Date</label>
                        <input type="date" class="form-control" id="modalExpenseDate" required />
                    </div>

                    <div class="mb-3">
                        <label for="modalExpenseDescription" class="form-label fw-semibold">Description <span class="text-muted fw-normal">(Optional)</span></label>
                        <textarea class="form-control" id="modalExpenseDescription" rows="2" placeholder="Additional details or notes..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="modalAddSubmitBtn" class="btn btn-primary fw-semibold">
                        <span id="modalAddSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
                        Save Expense
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/expense.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Set default date for modal to today
            const dateInput = document.getElementById("modalExpenseDate");
            if (dateInput) {
                dateInput.value = new Date().toISOString().split('T')[0];
            }

            // Initialize Dashboard & Categories
            ExpenseApp.initDashboard();
            ExpenseApp.loadCategories("modalExpenseCategory");
        });

        // Handle Quick Add Modal form submission
        async function handleQuickAddExpense(e) {
            e.preventDefault();

            const title = document.getElementById("modalExpenseTitle").value.trim();
            const amount = parseFloat(document.getElementById("modalExpenseAmount").value);
            const category = document.getElementById("modalExpenseCategory").value;
            const date = document.getElementById("modalExpenseDate").value;
            const description = document.getElementById("modalExpenseDescription").value.trim();
            const errorDiv = document.getElementById("modalAddError");
            const btn = document.getElementById("modalAddSubmitBtn");
            const spinner = document.getElementById("modalAddSpinner");

            errorDiv.classList.add("d-none");
            errorDiv.textContent = "";

            if (!title || isNaN(amount) || amount <= 0 || !category || !date) {
                errorDiv.textContent = "Please fill in all required fields with valid values.";
                errorDiv.classList.remove("d-none");
                return;
            }

            btn.disabled = true;
            spinner.classList.remove("d-none");

            try {
                const response = await Auth.fetchWithAuth("/api/expenses", {
                    method: "POST",
                    body: JSON.stringify({ title, amount, category, date, description })
                });

                if (!response.ok) {
                    const data = await response.json().catch(() => ({}));
                    throw new Error(data.message || "Failed to create expense.");
                }

                // Hide modal
                const modalEl = document.getElementById("quickAddExpenseModal");
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();

                // Reset form
                document.getElementById("quickAddExpenseForm").reset();
                document.getElementById("modalExpenseDate").value = new Date().toISOString().split('T')[0];

                showGlobalAlert(`Expense "${title}" was successfully recorded!`, "success");

                // Refresh dashboard stats and table
                await ExpenseApp.loadSummary();
                await ExpenseApp.loadExpenses();

            } catch (err) {
                errorDiv.textContent = err.message;
                errorDiv.classList.remove("d-none");
            } finally {
                btn.disabled = false;
                spinner.classList.add("d-none");
            }
        }
    </script>
}
