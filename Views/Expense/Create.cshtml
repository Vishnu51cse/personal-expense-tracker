@{
    ViewData["Title"] = "Add Expense";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h3 class="fw-bold text-dark mb-0">
                <i class="bi bi-plus-circle text-primary me-2"></i>Add New Expense
            </h3>
            <a href="/Expense/Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>

        <div class="card shadow-sm p-4 bg-white">
            <div id="addExpenseError" class="alert alert-danger d-none" role="alert"></div>

            <form id="createExpenseForm" onsubmit="handleCreateExpense(event)">
                <div class="mb-3">
                    <label for="expenseTitle" class="form-label fw-semibold">Title</label>
                    <input type="text" class="form-control" id="expenseTitle" placeholder="e.g. Monthly Electricity Bill" required maxlength="100" autofocus />
                    <div class="form-text">Brief label identifying this expense.</div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label for="expenseAmount" class="form-label fw-semibold">Amount (₹)</label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input type="number" step="0.01" min="0.01" max="10000000" class="form-control" id="expenseAmount" placeholder="0.00" required />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label for="expenseCategory" class="form-label fw-semibold">Category</label>
                        <select id="expenseCategory" class="form-select" required>
                            <option value="">-- Loading Categories --</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="expenseDate" class="form-label fw-semibold">Date Incurred</label>
                    <input type="date" class="form-control" id="expenseDate" required />
                </div>

                <div class="mb-4">
                    <label for="expenseDescription" class="form-label fw-semibold">Description <span class="text-muted fw-normal">(Optional)</span></label>
                    <textarea class="form-control" id="expenseDescription" rows="3" placeholder="Optional notes or vendor information..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/Expense/Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" id="submitCreateBtn" class="btn btn-primary px-4 fw-semibold">
                        <span id="submitCreateSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status"></span>
                        <i class="bi bi-check-lg me-1"></i> Save Expense
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/expense.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            if (!Auth.requireAuth()) return;

            // Set default date to today
            document.getElementById("expenseDate").value = new Date().toISOString().split('T')[0];

            // Load categories dropdown
            await ExpenseApp.loadCategories("expenseCategory");
        });

        async function handleCreateExpense(e) {
            e.preventDefault();

            const title = document.getElementById("expenseTitle").value.trim();
            const amount = parseFloat(document.getElementById("expenseAmount").value);
            const category = document.getElementById("expenseCategory").value;
            const date = document.getElementById("expenseDate").value;
            const description = document.getElementById("expenseDescription").value.trim();
            const errorDiv = document.getElementById("addExpenseError");
            const btn = document.getElementById("submitCreateBtn");
            const spinner = document.getElementById("submitCreateSpinner");

            errorDiv.classList.add("d-none");
            errorDiv.textContent = "";

            if (!title || isNaN(amount) || amount <= 0 || !category || !date) {
                errorDiv.textContent = "Please fill in all required fields.";
                errorDiv.classList.remove("d-none");
                return;
            }

            btn.disabled = true;
            spinner.classList.remove("d-none");

            try {
                const response = await Auth.fetchWithAuth("/api/expenses", {
                    method: "POST",
                    body: JSON.stringify({ title, amount, category, date, description })
                });

                if (!response.ok) {
                    const data = await response.json().catch(() => ({}));
                    throw new Error(data.message || "Failed to create expense.");
                }

                // Redirect to dashboard
                window.location.href = "/Expense/Index";

            } catch (err) {
                errorDiv.textContent = err.message;
                errorDiv.classList.remove("d-none");
            } finally {
                btn.disabled = false;
                spinner.classList.add("d-none");
            }
        }
    </script>
}
