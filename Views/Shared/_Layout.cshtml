<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Personal Expense Tracker</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Application Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-wallet2 fs-4 me-2 text-primary"></i>
                    <span>Expense<span class="text-dark">Tracker</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-secondary" asp-controller="Expense" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary" asp-controller="Expense" asp-action="Create">
                                <i class="bi bi-plus-circle me-1"></i> Add Expense
                            </a>
                        </li>
                    </ul>
                    <!-- Dynamic Auth Section (populated via auth.js) -->
                    <ul class="navbar-nav align-items-center" id="navbarAuthSection">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Account/Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm ms-2 text-white" href="/Account/Register">
                                <i class="bi bi-person-plus me-1"></i> Register
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <!-- Global alert container for notifications -->
        <div id="globalAlert" class="alert d-none alert-dismissible fade show" role="alert">
            <span id="globalAlertMessage"></span>
            <button type="button" class="btn-close" onclick="document.getElementById('globalAlert').classList.add('d-none')"></button>
        </div>

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container d-flex justify-content-between align-items-center">
            <span>&copy; 2026 Personal Expense Tracker &bull; Built with ASP.NET Core &amp; JWT Bearer</span>
            <span class="badge bg-light text-secondary border">ASP.NET Core 9.0 &bull; EF Core &bull; SQL Server</span>
        </div>
    </footer>

    <!-- Bootstrap Bundle with Popper -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Authentication helper script -->
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <!-- Global notification helper -->
    <script>
        function showGlobalAlert(message, type = "info") {
            const alert = document.getElementById("globalAlert");
            const text = document.getElementById("globalAlertMessage");
            if (!alert || !text) return;
            alert.className = `alert alert-${type} alert-dismissible fade show`;
            text.textContent = message;
            alert.classList.remove("d-none");
            setTimeout(() => {
                alert.classList.add("d-none");
            }, 5000);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
